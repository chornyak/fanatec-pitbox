#!/bin/sh
# Launch Fanatec Pitbox from this checkout, from any working directory.
# The working directory is left alone: with --setup N %command% the game must start where Steam put it.
DIR=$(dirname "$(readlink -f "$0")")
PYTHONPATH="$DIR${PYTHONPATH:+:$PYTHONPATH}" exec python3 -m fanatec_pitbox "$@"
