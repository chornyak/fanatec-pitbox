/* Fanatec Pitbox, design direction "1a Refined" (design/design_handoff_pitbox_1a/README.md).

   Tokens
   window #111214 · panel #17181b · panel strip #141518 · selected row #1f2126 · code field #0e0f11
   borders: panel #232529 · control #3a3d42 · disabled control #2a2c30 · row divider #1d1f23
   text: primary #e8e8e9 · secondary #c9cacd · body-muted #a9acb1 · muted #9a9da3 · helper #8a8d93
         faint #6c6f75 · disabled #55585e
   yellow #f2e600 = primary action / active / unwritten change (PC side); "was" #a9a04a
   teal #2bb8aa = things on / going to the wheel base; links
   status: ok #3cc46a · warning #f2a600 · fail #e0584d
   radii: panel 6 · dialog 10 · button/input 4 · pill 9 · badge 3 */

* {
    font-family: "Noto Sans";
    font-size: 13px;
    color: #e8e8e9;
}
QMainWindow, QWidget#root, QDialog, QMessageBox, QInputDialog {
    background: #111214;
}
QToolTip {
    background: #1f2126;
    color: #e8e8e9;
    border: 1px solid #3a3d42;
    padding: 6px;
}

/* ---- app shell ------------------------------------------------------------------------------ */
QWidget#appHeader {
    background: #111214;
    border-bottom: 1px solid #232529;
}
QLabel#overline {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1.5px;
    color: #9a9da3;
}
QLabel#baseTitle {
    font-size: 22px;
    font-weight: 700;
    letter-spacing: 0.3px;
}
QLabel#boostTag {
    background: #2bb8aa;
    color: #111214;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 1px;
    padding: 2px 7px;
    border-radius: 3px;
}
QLabel#readoutLabel {
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 1.2px;
    color: #6c6f75;
}
QLabel#readoutValue {
    font-size: 13px;
    color: #e8e8e9;
}
QLabel#statusDot {
    border-radius: 3px;
    background: #55585e;
}
QLabel#statusDot[state="ok"] {
    background: #3cc46a;
}
QLabel#statusDot[state="warn"] {
    background: #f2a600;
}
QLabel#statusDot[state="fail"] {
    background: #e0584d;
}
QPushButton#tab {
    border: none;
    border-bottom: 2px solid transparent;
    padding: 0 0 10px 0;
    font-size: 14px;
    font-weight: 600;
    color: #a9acb1;
    background: transparent;
}
QPushButton#tab:hover {
    color: #e8e8e9;
}
QPushButton#tab:checked {
    color: #f2e600;
    border-bottom: 2px solid #f2e600;
}
QLabel#banner {
    background: #1c1b10;
    border: 1px solid #4d4a1c;
    border-radius: 6px;
    color: #e8e8e9;
    padding: 10px 14px;
}
QStatusBar {
    background: #111214;
    color: #8a8d93;
    border-top: 1px solid #1d1f23;
}
QStatusBar QLabel {
    color: #8a8d93;
    font-size: 12px;
    padding: 0 8px;
}

/* ---- text roles ----------------------------------------------------------------------------- */
QLabel#sectionLabel, QLabel#panelTitle {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 1.5px;
    color: #9a9da3;
}
QLabel#sideTitle {
    font-size: 19px;
    font-weight: 600;
}
QLabel#dim {
    font-size: 12.5px;
    color: #8a8d93;
}
QLabel#faint {
    font-size: 11.5px;
    color: #6c6f75;
}
QLabel#mono, QLabel#fixCommand {
    font-family: "Noto Sans Mono";
}
QLabel[muted="true"] {
    color: #55585e;
}
QFrame#rule {
    background: #232529;
    max-height: 1px;
    border: none;
}

/* ---- panels --------------------------------------------------------------------------------- */
QFrame#panel {
    background: #17181b;
    border: 1px solid #232529;
    border-radius: 6px;
}
QWidget#sidebar, QWidget#scrollHolder, QScrollArea {
    background: transparent;
    border: none;
}

/* ---- buttons -------------------------------------------------------------------------------- */
QPushButton, QToolButton#menuButton {
    background: transparent;
    border: 1px solid #3a3d42;
    border-radius: 4px;
    padding: 7px 14px;
    font-weight: 500;
    color: #e8e8e9;
}
QPushButton:hover, QToolButton#menuButton:hover {
    border-color: #6c6f75;
}
QPushButton:pressed {
    background: #1f2126;
}
QPushButton:disabled {
    border-color: #2a2c30;
    color: #55585e;
}
/* the one filled yellow button per screen */
QPushButton[primary="true"] {
    background: #f2e600;
    border: 1px solid #f2e600;
    color: #111214;
    font-weight: 700;
    padding: 8px 16px;
}
QPushButton[primary="true"]:hover {
    background: #fff35a;
    border-color: #fff35a;
}
QPushButton[primary="true"]:disabled {
    background: transparent;
    border-color: #2a2c30;
    color: #55585e;
}
/* goes to the wheel base (e.g. Load into wheel base) */
QPushButton[teal="true"] {
    border: 1.5px solid #2bb8aa;
    color: #2bb8aa;
    font-weight: 600;
}
QPushButton[teal="true"]:hover {
    background: #13302d;
}
/* legacy yellow outline, until each screen moves to primary/secondary */
QPushButton[accent="true"] {
    border: 1.5px solid #f2e600;
    color: #f2e600;
    font-weight: 700;
}
QPushButton[accent="true"]:disabled {
    border-color: #2a2c30;
    color: #55585e;
}
QPushButton[danger="true"] {
    border-color: transparent;
    color: #e0584d;
}
QPushButton[danger="true"]:hover {
    border-color: #e0584d;
}
QPushButton#small {
    padding: 5px 10px;
    font-weight: 500;
}

/* ---- inputs --------------------------------------------------------------------------------- */
QSlider::groove:horizontal {
    height: 4px;
    background: #2e3035;
    border-radius: 2px;
}
QSlider::sub-page:horizontal {
    height: 4px;
    background: #2bb8aa;
    border-radius: 2px;
}
QSlider[dirty="true"]::sub-page:horizontal {
    background: #f2e600;
}
QSlider::handle:horizontal {
    background: #ffffff;
    width: 14px;
    height: 14px;
    margin: -5px 0;
    border-radius: 7px;
}
QSlider::sub-page:horizontal:disabled {
    background: #3a3c40;
}
QSlider::handle:horizontal:disabled {
    background: #6a6c70;
}
QSpinBox {
    background: #1d1f23;
    border: 1px solid #3a3d42;
    border-radius: 4px;
    padding: 3px 2px;
    min-height: 24px;
    font-size: 13.5px;
    selection-background-color: #f2e600;
    selection-color: #111214;
}
QSpinBox:focus {
    border-color: #6c6f75;
}
QSpinBox[dirty="true"] {
    border: 1.5px solid #f2e600;
    color: #f2e600;
}
QSpinBox:disabled, QComboBox:disabled {
    border-color: #2a2c30;
    color: #55585e;
}
QComboBox {
    background: #17181b;
    border: 1px solid #3a3d42;
    border-radius: 4px;
    padding: 7px 12px;
    min-width: 90px;
}
QComboBox::drop-down {
    border: none;
    width: 24px;
}
QComboBox::down-arrow {
    image: url(icons:chevron-down.svg);
    width: 10px;
    height: 6px;
}
QComboBox::down-arrow:disabled {
    image: none;
}
QComboBox QAbstractItemView {
    background: #1f2126;
    selection-background-color: #2a2c31;
    selection-color: #e8e8e9;
    border: 1px solid #3a3d42;
    outline: none;
}
QLineEdit {
    background: #0e0f11;
    border: 1px solid #3a3d42;
    border-radius: 4px;
    padding: 6px 8px;
}
QRadioButton, QCheckBox {
    spacing: 8px;
}
QRadioButton::indicator {
    width: 14px;
    height: 14px;
    border-radius: 8px;
    border: 1px solid #6c6f75;
    background: transparent;
}
QRadioButton::indicator:checked {
    border: 2px solid #f2e600;
    background: qradialgradient(cx:0.5, cy:0.5, radius:0.5, fx:0.5, fy:0.5,
                                stop:0 #f2e600, stop:0.5 #f2e600, stop:0.6 transparent);
}
QCheckBox::indicator {
    width: 14px;
    height: 14px;
    border: 1px solid #6c6f75;
    border-radius: 3px;
    background: transparent;
}
QCheckBox::indicator:checked {
    border: 1px solid #f2e600;
    background: #f2e600;
}
QCheckBox#modeToggle::indicator {
    width: 38px;
    height: 18px;
    border: 1px solid #3a3d42;
    border-radius: 3px;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 #c9cacd, stop:0.45 #c9cacd, stop:0.46 transparent);
}
QCheckBox#modeToggle::indicator:checked {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 transparent, stop:0.54 transparent, stop:0.55 #f2e600);
}
QListWidget {
    background: transparent;
    border: none;
    outline: none;
}
QListWidget::item {
    padding: 9px 10px;
    border-radius: 4px;
    color: #c9cacd;
}
QListWidget::item:hover {
    background: #1b1c20;
}
QListWidget::item:selected {
    background: #1f2126;
    color: #e8e8e9;
}
QScrollBar:vertical {
    background: transparent;
    width: 8px;
    margin: 0;
}
QScrollBar::handle:vertical {
    background: #3a3d42;
    min-height: 40px;
    border-radius: 4px;
}
QScrollBar::handle:vertical:hover {
    background: #55585e;
}
QScrollBar::add-line, QScrollBar::sub-line, QScrollBar::add-page, QScrollBar::sub-page {
    height: 0;
    background: none;
}

/* ---- tuning ------------------------------------------------------------------------------- */
QLabel#editingName {
    font-size: 18px;
    font-weight: 600;
}
QLabel#toolbarLabel {
    color: #a9acb1;
}
QLabel#groupTitle {
    font-size: 11.5px;
    font-weight: 700;
    letter-spacing: 1.4px;
    color: #9a9da3;
}
QFrame#segmented {
    border: 1px solid #3a3d42;
    border-radius: 5px;
    background: transparent;
}
QPushButton#segment {
    border: none;
    border-radius: 3px;
    padding: 3px 12px;
    color: #a9acb1;
    font-weight: 500;
    background: transparent;
}
QPushButton#segment:hover {
    color: #e8e8e9;
}
QPushButton#segment:checked {
    background: #2a2c31;
    color: #e8e8e9;
    font-weight: 700;
}
QPushButton#segment:disabled {
    color: #55585e;
}
QPushButton#segment:checked:disabled {
    background: #1f2126;
}
QToolButton#menuButton {
    padding: 0 12px;
}
QToolButton#menuButton::menu-indicator {
    image: none;
    width: 0;
}
QMenu {
    background: #1f2126;
    border: 1px solid #3a3d42;
    border-radius: 6px;
    padding: 4px;
}
QMenu::item {
    padding: 7px 16px;
    border-radius: 4px;
}
QMenu::item:selected {
    background: #2a2c31;
}
QMenu::item:disabled {
    color: #55585e;
}
QLabel#paramTitle {
    font-size: 13.5px;
    font-weight: 500;
}
QLabel#paramTitle[dirty="true"] {
    color: #f2e600;
}
QLabel#codeChip {
    font-family: "Noto Sans Mono";
    font-size: 10px;
    color: #9a9da3;
    background: #202227;
    border-radius: 3px;
    padding: 1px 5px;
}
QLabel#wasHint {
    font-size: 11.5px;
    color: #a9a04a;
}
QLabel#infoIcon {
    border: 1px solid #6c6f75;
    border-radius: 7px;
    color: #9a9da3;
    font-size: 9px;
    font-weight: 700;
}
QFrame#dirtyBar {
    background: #1c1b10;
    border-top: 1px solid #4d4a1c;
}
QLabel#dirtyDot {
    background: #f2e600;
    border-radius: 3px;
}
QLabel#draftNote {
    color: #f2e600;
    font-weight: 700;
}
QFrame#slotCard {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 6px;
}
QFrame#slotCard:hover {
    background: #17181b;
}
QFrame#slotCard[active="true"] {
    background: #1f2126;
    border: 1px solid #3a3d42;
}
QLabel#slotNumber {
    font-family: "Noto Sans Mono";
    font-size: 12px;
    color: #9a9da3;
    background: #1d1f23;
    border: 1px solid #2a2c30;
    border-radius: 4px;
}
QLabel#slotNumber[active="true"] {
    background: #f2e600;
    border: 1px solid #f2e600;
    color: #111214;
    font-weight: 500;
}
QLabel#slotTitle {
    font-size: 14px;
    font-weight: 600;
}
QLabel#slotSummary {
    font-size: 11.5px;
    color: #8a8d93;
}
QToolButton#slotEdit {
    border: none;
    color: #55585e;
    padding: 0 4px;
    background: transparent;
}
QToolButton#slotEdit:hover {
    color: #e8e8e9;
}

/* ---- settings ------------------------------------------------------------------------------ */
QLabel#rowTitle {
    font-size: 14px;
    font-weight: 500;
}
QLabel#modelValue {
    font-size: 14px;
    font-weight: 600;
}
QLabel#modelValue[muted="true"] {
    color: #8a8d93;
    font-weight: 500;
}
QLabel#metaLabel {
    font-size: 11.5px;
    color: #6c6f75;
}
QLabel#metaValue {
    font-size: 11.5px;
    color: #8a8d93;
}
QLabel#metaText {
    font-size: 12.5px;
    color: #c9cacd;
}
QLabel#metaMono {
    font-family: "Noto Sans Mono";
    font-size: 12.5px;
    color: #c9cacd;
}
QLabel#tealLabel, QLabel#yellowLabel {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1.2px;
    color: #2bb8aa;
}
QLabel#yellowLabel {
    color: #f2e600;
}
QLabel#bodyMuted {
    font-size: 12.5px;
    color: #a9acb1;
}
QFrame#vrule {
    background: #232529;
    border: none;
}
QLabel#setupNumber {
    font-family: "Noto Sans Mono";
    font-size: 11.5px;
    color: #9a9da3;
    background: #1d1f23;
    border-radius: 4px;
}
QLabel#setupNumber[active="true"] {
    background: #f2e600;
    color: #111214;
}
QLabel#setupName {
    font-size: 13px;
    font-weight: 500;
}
QLabel#differsNote {
    font-size: 12.5px;
    color: #f2e600;
}
QFrame#profileRow {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 5px;
}
QFrame#profileRow:hover {
    background: #1b1c20;
}
QFrame#profileRow[selected="true"] {
    background: #1f2126;
    border: 1px solid #3a3d42;
}
QLabel#profileName {
    font-size: 14px;
    font-weight: 500;
}
QLabel#profileName[selected="true"] {
    font-weight: 600;
}
QLabel#loadedPill {
    font-size: 11px;
    font-weight: 600;
    color: #a9acb1;
    border: 1px solid #3a3d42;
    border-radius: 8px;
    padding: 1px 7px;
}
QToolButton#moreButton {
    border: none;
    border-radius: 4px;
    color: #6c6f75;
    font-size: 15px;
    background: transparent;
}
QToolButton#moreButton:hover {
    background: #2a2c31;
    color: #e8e8e9;
}
QToolButton#moreButton::menu-indicator {
    image: none;
    width: 0;
}
QLabel#disclosureTitle {
    font-size: 13px;
    font-weight: 500;
    color: #c9cacd;
}
QLabel#countPill {
    font-size: 11.5px;
    color: #8a8d93;
    background: #232529;
    border-radius: 8px;
    padding: 1px 7px;
}
QPushButton#addButton {
    padding: 0;
    border: 1px solid #3a3d42;
    border-radius: 6px;
    font-size: 18px;
    font-weight: 500;
    color: #e8e8e9;
}
QPushButton#addButton:hover {
    border-color: #f2e600;
    color: #f2e600;
}
QPushButton#addButton:disabled {
    border-color: #2a2c30;
    color: #55585e;
}
QLineEdit#codeField {
    font-family: "Noto Sans Mono";
    font-size: 12.5px;
    color: #c9cacd;
    background: #0e0f11;
    border: 1px solid #232529;
    padding: 6px 10px;
}

/* ---- dialogs (shared frame) ------------------------------------------------------------------ */
QLabel#dialogTitle {
    font-size: 19px;
    font-weight: 600;
}
QLabel#dialogSubtitle {
    font-size: 13px;
    color: #a9acb1;
}
QFrame#dialogFooter {
    border-top: 1px solid #232529;
    background: #111214;
}
QFrame#radioCard {
    background: transparent;
    border: 1px solid #232529;
    border-radius: 6px;
}
QFrame#radioCard[selected="true"] {
    background: #1f2126;
    border: 1px solid #3a3d42;
}
QLabel#cardTitle {
    font-size: 13.5px;
    font-weight: 500;
}

/* ---- input test (to be refined with the Input test screen) ----------------------------------- */
QLabel#gear {
    font-size: 40px;
    font-weight: 800;
    color: #f2e600;
}

/* ---- checks & dialogs ---------------------------------------------------------------------- */
QLabel#statusDot[state="skip"] {
    background: #3a3d42;
}
QLabel#checkSummary {
    font-size: 13.5px;
    font-weight: 600;
    color: #3cc46a;
}
QLabel#checkSummary[state="warn"] {
    color: #f2a600;
}
QLabel#checkSummary[state="fail"] {
    color: #e0584d;
}
QWidget#checkRow {
    border-bottom: 1px solid #232529;
}
QLabel#checkTitle {
    font-size: 13.5px;
    font-weight: 500;
}
QLineEdit#fixCommand {
    font-family: "Noto Sans Mono";
    font-size: 12px;
    color: #c9cacd;
    background: #0e0f11;
    border: 1px solid #232529;
    border-radius: 4px;
    padding: 5px 10px;
}
QFrame#stepBar {
    background: #2e3035;
    border-radius: 1px;
    border: none;
}
QFrame#stepBar[done="true"] {
    background: #f2e600;
}
QLabel#stepName {
    font-size: 12.5px;
    font-weight: 500;
    color: #6c6f75;
}
QLabel#stepName[current="true"] {
    color: #e8e8e9;
    font-weight: 600;
}
QFrame#radioCard {
    background: #17181b;
    border: 1px solid #232529;
    border-radius: 6px;
}
QFrame#radioCard[selected="true"] {
    background: #1f2126;
    border: 1px solid #3a3d42;
}
QLabel#cardTitle {
    font-size: 13.5px;
    font-weight: 500;
}
QLabel#cardTitle[selected="true"] {
    font-weight: 600;
}
QFrame#radioCard QRadioButton::indicator {
    width: 12px;
    height: 12px;
    border-radius: 8px;
    border: 2px solid #55585e;
}
QFrame#radioCard QRadioButton::indicator:checked {
    border: 2px solid #f2e600;
    background: qradialgradient(cx:0.5, cy:0.5, radius:0.5, fx:0.5, fy:0.5,
                                stop:0 #f2e600, stop:0.55 #f2e600, stop:0.62 transparent);
}
QLabel#footnote {
    font-size: 11px;
    color: #6c6f75;
}
QWidget#tableHead {
    border-bottom: 1px solid #232529;
}
QLabel#tableHeadCell {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1.2px;
    color: #6c6f75;
}
QWidget#tableRow {
    border-bottom: 1px solid #1d1f23;
}
QLabel#tableSetting, QLabel#tableNew {
    color: #a9acb1;
}
QLabel#tableSettingChanged {
    color: #e8e8e9;
}
QLabel#tableCurrent {
    color: #6c6f75;
}
QLabel#tableArrow {
    font-size: 12px;
    color: #a9a04a;
}
QLabel#tableNewChanged {
    color: #f2e600;
    font-weight: 600;
}
QLabel#profileDetail {
    padding: 4px 0;
}
